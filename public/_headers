# Cloudflare Pages response headers
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=2592000
/route/*
  Cache-Control: public, max-age=604800
/og.png
  Cache-Control: public, max-age=604800
